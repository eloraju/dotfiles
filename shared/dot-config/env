#!/usr/bin/env bash

export LOCAL_BIN=$HOME/.local/bin
export USER_BIN=$HOME/.bin
LOCAL_BINS=$LOCAL_BIN:$USER_BIN:

# XDG DIRS
export XDG_CONFIG_HOME=$HOME/.config
export XDG_CACHE_HOME=$HOME/.local/cache
export XDG_DATA_HOME=$HOME/.local/share

# GnuPG
export GNUPGHOME=$XDG_DATA_HOME/gnupg

# nvim as editor
export VISUAL=nvim
export EDITOR=$VISUAL
export SUDO_EDITOR=$VISUAL

export KEYTIMEOUT=1

# https://www.reddit.com/r/neovim/comments/1k1k9bz/use_neovim_as_the_default_man_page_viewer/
# Note: when running man from the shell with Nvim as $MANPAGER, man will
# pre-format the manpage using groff, and Nvim will display the manual page as
# it was received from stdin (it can't "undo" the hard-wrap caused by
# man/groff). To prevent man/groff from hard-wrapping the manpage, you can set
# $MANWIDTH=999 in your environment.

export MANWIDTH=999
export MANPAGER="nvim +Man!"

export NVM_DIR="$HOME/.nvm"

# clean up path... it gets crowded when reloading configs
export PATH=$(echo "$LOCAL_BINS:$PATH" | tr ':' '\n' | sort | uniq | tr '\n' ':')

export COLORSCHEME="tokyo-night-storm"

if [ -f "$XDG_CONFIG_HOME/colorschemes/$COLORSCHEME" ]; then
  source "$XDG_CONFIG_HOME/colorschemes/$COLORSCHEME"
fi
