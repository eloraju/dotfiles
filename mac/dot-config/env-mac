#!/usr/bin/env bash
# Mac specific environment variables

# Android studio stuff
export ANDROID_HOME="$HOME/Library/Android/sdk"
ANDROID_STUFF="$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$ANDROID_HOME/tools:$ANDROID_HOME/tools/bin"

# Bun
BUN_BIN=$HOME/.bun/bin/
# Add android binaries
PATH=$ANDROID_STUFF:$BUN_BIN:$PATH


eval "$(/opt/homebrew/bin/brew shellenv)"
